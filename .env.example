# TMDB API read access token (v4) — required for search suggestions in the add-film form.
# Get one at https://www.themoviedb.org/settings/api ("API Read Access Token").
TMDB_READ_ACCESS_TOKEN=

# SQLite database file location (optional; defaults to ./data/letterboxd.db).
# docker-compose.yml overrides this to /data/letterboxd.db (inside the container volume).
# DATABASE_PATH=./data/letterboxd.db

# HTTP port the server listens on (optional; Nitro defaults to 3000).
# NITRO_PORT=3000

# Raw Letterboxd cookie string for the authenticated "like a review" feature.
# Log in to letterboxd.com in a desktop browser, open DevTools > Application
# (or Network > any request) > Cookies, and copy the entire Cookie header value.
# It must contain the auth cookies and the com.xk72.webparts.csrf token.
# Server-side only — never log it or send it to the client.
LETTERBOXD_COOKIE=

# The user agent LETTERBOXD_COOKIE's cf_clearance was minted with — Cloudflare
# binds clearance cookies to the user agent, so this must match the browser
# the cookie string was copied from.
LETTERBOXD_USER_AGENT=
